import hashlib
import re

import base64
import time
import hmac

import logging
import json
import os
import sys
from collections import defaultdict
import click

log = logging.getLogger(__name__)

def engine(elm, **kwargs):
    """This is common engine for all commands"""
    import requests

    logging.debug('passed kwargs: %s', kwargs)
    logging.info('elm.command: %s', elm.command)
    logging.info('elm.path: %s', elm.path)
    logging.info('elm.format: %s', elm.format)
    logging.info('elm.noheader: %s', elm.noheader)
    logging.info('elm.index: %s', elm.index)
    logging.info('elm.filename: %s', elm.filename)
    logging.info('elm.head: %s', elm.head)
    logging.info('elm.foot: %s', elm.foot)
    logging.info('elm.halt_on_api_error: %s', elm.halt_on_api_error)

    # ben magic, throw away False and Empty flags (also zeros!)
    flags = {k: v for k, v in kwargs.items() if v}
    logging.debug('passed flags: %s', flags)

    # After the command name -f is --fields, so 'elm DeviceList -f csv' asks for a
    # field called csv. Catch it before sending the request.
    if 'fields' in flags:
        root = click.get_current_context().find_root()
        formats = next((p.type.choices for p in root.command.params if p.name == 'format'), [])
        if flags['fields'] in formats:
            raise click.UsageError(
                f"-f after the command name is --fields, and '{flags['fields']}' is an output format.\n"
                f"Hint: for --format put it before the command name, e.g. elm -f {flags['fields']} {elm.command}")

    #set size to max (1000) if size is 0
    #0 values are removed by ben magic above
    if 'size' in kwargs and kwargs['size'] == 0:
        logging.debug('kwargs[\'size\']: %s', kwargs['size'])
        logging.debug('size set to 0, changing to 1000 for max size allowed by api')
        flags['size'] = 1000
        logging.debug('kwargs[\'size\']: %s', kwargs['size'])

    #construct path based on passed attributes (path values)
    # find placeholders between {} and collect in attributes var for below
    attributes = re.findall(r'\{([A-Za-z0-9_]+?)\}',elm.path)
    logging.debug('attributes: %s', attributes)

    #for every attribute in the path found above, swap in the value and construct the path for the url
    for attribute in attributes:
        logging.debug('ins "%s" value "%s" into %s', attribute, flags[attribute], elm.path)
        elm.path = elm.path.replace("{" + attribute + "}", str(flags[attribute]))

        # remove the attribute from flags cause we've handle it
        logging.debug('del "%s" from flags', attribute)
        del flags[attribute]

    #todo: check for any remaining attributes by looking for {} in elm.path
    #logging.warning('not all attributes replaced in path: %s', elm.path)

    logging.debug('elm.path attributes: %s', elm.path)
    logging.debug('remaining flags: %s', flags)

    #construct resourcePath
    resourcePath = elm.path
    logging.debug('resourcePath: %s', resourcePath)

    #construct queryParams
    queryParams = ''

    #turn flags into queryParams key values
    _output_only = {'count', 'total'}
    for flag in flags:
        if flag in _output_only:
            continue
        logging.debug('flag: %s', flag)
        logging.debug('flags[flag]: %s', flags[flag])
        # dotted -f names (privileges.objectName) are picked out here, after the
        # response: LM is asked for the top-level field
        value = top_fields(flags[flag]) if flag == 'fields' else flags[flag]
        queryParams += '&' + flag + '=' + str(value)

    logging.debug('queryParams: %s', queryParams)

    #one portal, unless several profiles were given (-p a,b)
    if not elm.portals:
        fetched = fetch(elm, flags, resourcePath, queryParams, elm.access_id, elm.access_key, elm.account_name)
        if fetched:
            report(elm, flags, *fetched)
        return

    results = []
    failed = []
    for name, access_id, access_key, account_name in elm.portals:
        logging.info('profile: %s', name)
        fetched = fetch(elm, flags, resourcePath, queryParams, access_id, access_key, account_name, name)
        if not fetched:
            failed.append(name)
            continue
        obj, url, auth = fetched
        if elm.format in ('api', 'curl', 'wget'):
            click.echo('# ' + name)
            report(elm, flags, obj, url, auth)
        else:
            results.append((name, *rows(elm, flags, obj, name)))

    if elm.format not in ('api', 'curl', 'wget'):
        report_portals(elm, flags, results, failed)
    if failed:
        # diff's convention: 0 same, 1 different, 2 trouble
        sys.exit(2 if elm.diff else 1)


def fetch(elm, flags, resourcePath, queryParams, access_id, access_key, account_name, profile=None):
    """Send the request to one portal: (obj, url, auth), or None if it failed."""
    import requests

    #Request Info
    httpVerb ='GET'
    logging.debug('httpVerb: %s', httpVerb)

    #construct URL
    url = 'https://'+ account_name +'.logicmonitor.com/santaba/rest' + resourcePath
    logging.debug('url: %s', url)

    data = ''
    logging.debug('data: %s', data)

    #Get current time in milliseconds
    epoch = str(int(time.time() * 1000))
    logging.debug('epoch: %s', epoch)

    #Concatenate Request details
    requestVars = httpVerb + epoch + data + resourcePath
    logging.debug('requestVars: %s', requestVars)

    #Construct signature
    hmac1 = hmac.new(access_key.encode(),msg=requestVars.encode(),digestmod=hashlib.sha256).hexdigest()
    signature = base64.b64encode(hmac1.encode())

    #Construct html headers
    auth = 'LMv1 ' + access_id + ':' + signature.decode() + ':' + epoch
    # dont show this as it has the api auth details
    #logging.info('auth: %s', auth)
    headers = {'Content-Type':'application/json','Authorization':auth,'X-Version':'{{ apiversion }}'}
    # dont show this as it has the api auth details
    #logging.info('headers: %s', headers)

    try:
        #Make request
        response = requests.get(url, data=data, headers=headers, params=queryParams, timeout=(10, 120), verify=elm.cacert if elm.cacert else True)
        response.encoding = 'utf-8'

        # Safely access and log rate-limit headers if they exist
        rate_limit_headers = {
            'Limit': response.headers.get('X-Rate-Limit-Limit', 'Header not found'),
            'Remaining': response.headers.get('X-Rate-Limit-Remaining', 'Header not found'),
            'Window': response.headers.get('X-Rate-Limit-Window', 'Header not found')
        }
        logging.debug('Rate Limit Headers: %s', rate_limit_headers)

        # Check for HTTP errors
        response.raise_for_status()

        # Log response details
        logging.info('Response URL: %s', response.url)
        logging.info('Status code: %s', response.status_code)
        logging.info('Elapsed time: %.3fs', response.elapsed.total_seconds())
        logging.debug('Response Content: %s', response.content)

    except requests.RequestException as e:
        click.secho('Error: request failed', fg='red', err=True)
        if profile:
            click.secho(f'Profile: {profile}', fg='red', err=True)
        if elm:
            click.secho(f'Command: {elm.command}', fg='red', err=True)
            click.secho(f'Path: {elm.path}', fg='red', err=True)
        click.secho(f'Flags: {str(flags)}', fg='red', err=True)

        # Check if it's specifically an HTTPError
        if isinstance(e, requests.exceptions.HTTPError):
            status_code = e.response.status_code
            click.secho(f'HTTP error occurred: {e}', fg='red', err=True)

            # Handle specific status codes
            if status_code == 400:
                logging.error('Bad Request (400): The request was invalid or cannot be served.')
            elif status_code == 401:
                logging.error('Unauthorized (401): Authentication is required and has failed or not been provided.')
            elif status_code == 403:
                logging.error('Forbidden (403): You do not have permission to access this resource.')
            elif status_code == 404:
                logging.error('Not Found (404): The requested resource could not be found.')
            elif status_code == 429:
                logging.error('Too Many Requests (429): You have exceeded the rate limit.')
            elif status_code == 500:
                logging.error('Internal Server Error (500): The server encountered an unexpected condition.')
            elif status_code == 503:
                logging.error('Service Unavailable (503): The server is currently unavailable (overloaded or down).')
            else:
                logging.error(f'Unexpected HTTP error occurred: Status code {status_code}')
        else:
            # General request error handling
            logging.error(f'Request failed: {e}')

        # Abort if configured to halt on error, otherwise return cleanly
        if elm.halt_on_api_error:
            raise click.Abort()
        return None

    #obj = response.content
    obj = response.json()
    #obj = response.content.decode('utf-8')

    #not every endpoint returns the usual {total, items, ...} envelope
    if isinstance(obj, list):
        # a bare JSON array: /setting/logicmodules/metadata (V4Metadata) is the
        # known case. Wrapping it the same way as a single record would bury the
        # whole list one level deeper ([[{...}]]), which breaks everything
        # downstream -- -c/-C report 1, the table formats render a single row of
        # column numbers, and the post-output field check crashes on list.keys().
        logging.debug('obj is a bare list, using it as items')
        obj = {
            "total": len(obj),
            "items": obj,
            "searchId": None,
            "isMin": False
        }
    #used for queries by id, which only return one item
    elif 'items' not in obj:
        logging.debug('items not in obj, setting to defaults')
        obj = {
            "total": 1,
            "items": [obj],
            "searchId": None,
            "isMin": False
        }

    logging.info('Total records: %s', obj.get('total', None))
    logging.debug('searchId: %s', obj.get('searchId', None))
    logging.debug('isMin: %s', obj.get('isMin', None))
    logging.debug('obj: %s', obj)
    return obj, response.url, auth


def report(elm, flags, obj, url, auth):
    """Print one portal's response, in the format asked for."""
    if elm.format == "api":
        click.echo(url)
        click.echo("Authorization: " + auth)
    elif elm.format == "curl":
        click.echo('curl -H "Authorization: ' + auth + '" "' + url + '"')
    elif elm.format == "wget":
        click.echo('wget -O - --header="Authorization: ' + auth + '" "' + url + '"')
    elif 'total' in flags:
        logging.debug('total is a flag, showing total instead')
        if obj['total'] < 0:
            # LM returns -(n_returned + 1) when it cannot compute an exact total
            click.secho('Warning: total unknown, results may be truncated',
                        fg='yellow', err=True)
            click.echo('>{}'.format(abs(obj['total']) - 1))
        else:
            click.echo(obj['total'])
    elif 'count' in flags:
        logging.debug('count is a flag, showing count instead')
        # with -e, the rows after exploding: elm -e contacts PortalInfo -f contacts -c
        click.echo(len(explode(project(flags, obj), elm.explode)) if elm.explode else len(obj['items']))
    else:
        items = project(flags, obj)
        output(explode(items, elm.explode), elm.command, elm.filename, elm.format, elm.noheader, elm.index, elm.head, elm.foot)
        warn(flags, obj, items)


def requested(flags):
    """The -f names, in order."""
    return [f.strip() for f in flags.get('fields', '').split(',') if f.strip()]


def top_fields(fields):
    """What to ask LM for: the part of each -f name before any dot, once each."""
    return ','.join(dict.fromkeys(f.strip().split('.', 1)[0] for f in fields.split(',') if f.strip()))


def path_tree(names):
    """{'name': None, 'privileges': {'objectName': None}}: None keeps the whole value."""
    tree = {}
    for name in names:
        node = tree
        parts = name.split('.')
        for part in parts[:-1]:
            if part in node and node[part] is None:
                break       # the whole field is already wanted
            node = node.setdefault(part, {})
        else:
            node[parts[-1]] = None
    return tree


def trim(value, tree):
    """Keep only the fields in tree, looking inside lists of records."""
    if tree is None:
        return value
    if isinstance(value, list):
        return [trim(v, tree) for v in value]
    if isinstance(value, dict):
        return {k: trim(v, tree[k]) for k, v in value.items() if k in tree}
    return value


def project(flags, obj):
    """The items, trimmed to the requested fields; privileges.objectName picks a sub-field."""
    # Client-side field projection: trim each item to only the requested fields.
    # Defence against endpoints that ignore fields= (e.g. IntegrationList branded
    # types — upstream bug #52). No-op when the API already honoured fields=.
    if 'fields' in flags and obj['items']:
        tree = path_tree(requested(flags))
        return [trim(item, tree) for item in obj['items']]
    return obj['items']


def flatten(prefix, record, row):
    """Add a record's fields to row as prefix.key; records inside it too, lists stay whole."""
    for k, v in record.items():
        if isinstance(v, dict) and v:
            flatten(f'{prefix}.{k}', v, row)
        else:
            row[f'{prefix}.{k}'] = v


def explode(items, fields, profile=None):
    """One row per item of each -e list, the record's other fields repeated on each.

    A list of records becomes columns named field.key; an empty list keeps its
    row, blank. A record that is not in a list is flattened the same way.
    Several fields are one inside another (-e groups -e groups.members): the
    -e check in elm.py refuses separate lists, which would multiply.
    """
    for field in fields:
        if items and not any(field in item for item in items):
            import difflib
            label = f'{profile}: ' if profile else ''
            close = difflib.get_close_matches(field, set().union(*(item.keys() for item in items)), n=1)
            hint = f'did you mean {close[0]}?' if close else 'is it in -f?'
            click.secho(f'{label}Warning: nothing to explode, no field {field} in the results ({hint})',
                        fg='yellow', err=True)
            continue
        rows = []
        for item in items:
            if field not in item:
                rows.append(item)
                continue
            value = item[field]
            if value == []:
                # keep the record: its field.key columns come out blank
                rows.append({k: v for k, v in item.items() if k != field})
                continue
            for one in value if isinstance(value, list) else [value]:
                row = {}
                for k, v in item.items():
                    if k != field:
                        row[k] = v
                    elif isinstance(one, dict):
                        flatten(field, one, row)
                    else:
                        row[k] = one
                rows.append(row)
        items = rows
    return items


def paths(value, prefix=''):
    """Every field name in value, dotted below the top level, looking inside lists."""
    found = set()
    if isinstance(value, list):
        for v in value:
            found |= paths(v, prefix)
    elif isinstance(value, dict):
        for k, v in value.items():
            found.add(prefix + k)
            found |= paths(v, prefix + k + '.')
    return found


def warn(flags, obj, items, profile=None):
    """Warn about truncated results and requested fields that did not come back.

    Returns True if there were more rows than were fetched.
    """
    label = f'{profile}: ' if profile else ''
    truncated = False

    #if output() found no valid fields it already reported an error - suppress follow-on warnings
    returned = set().union(*(item.keys() for item in items))

    if returned:
        #give a warning if there are more records not shown
        if 'size' in flags:
            # compare against what this page actually reached, not the raw
            # total: with --offset the earlier pages already covered
            # everything below it, so total > size is not truncation.
            # ben magic drops offset=0, hence the .get() default.
            shown = int(flags.get('offset', 0)) + len(items)
            if obj['total'] < 0 or shown < obj['total']:
                truncated = True
                click.secho(label + 'Warning: results truncated by size limit',
                            fg='yellow', err=True)

    #warn if any requested fields were not returned by the API -- also when none
    #were, so "no valid fields selected" comes with the names that were wrong
    if 'fields' in flags and items:
        names = requested(flags)
        if any('.' in name for name in names):
            returned = paths(items)
        missing = set(names) - returned
        if missing:
            noun = 'field' if len(missing) == 1 else 'fields'
            click.secho(label + 'Warning: unknown {}: {}'.format(noun, ', '.join(sorted(missing))),
                        fg='yellow', err=True)
    return truncated


def rows(elm, flags, obj, profile):
    """One portal's rows when several are queried: its items, or its -c/-C count.

    Returns (rows, truncated).
    """
    if 'total' in flags:
        if obj['total'] < 0:
            click.secho(f'{profile}: Warning: total unknown, results may be truncated', fg='yellow', err=True)
            return [{'total': '>{}'.format(abs(obj['total']) - 1)}], False
        return [{'total': obj['total']}], False
    if 'count' in flags:
        count = len(explode(project(flags, obj), elm.explode, profile)) if elm.explode else len(obj['items'])
        return [{'count': count}], False
    items = project(flags, obj)
    if not items:
        click.secho(f'{profile}: Warning: no data found', fg='yellow', err=True)
    elif not any(items):
        click.secho(f'{profile}: Error: no valid fields selected', fg='red', err=True)
        return [], False
    truncated = warn(flags, obj, items, profile)
    return explode(items, elm.explode, profile), truncated


def report_portals(elm, flags, results, failed):
    """Print the rows from several portals: one table with profile and account_name columns, or one file each."""
    table = [(name, row) for name, items, _ in results for row in items]
    truncated = [name for name, _, cut in results if cut]

    if elm.diff:
        if failed:
            click.secho(f"Error: cannot compare, no data from: {', '.join(failed)}", fg='red', err=True)
            sys.exit(2)
        if 'fields' not in flags and 'count' not in flags and 'total' not in flags:
            click.secho('Warning: --diff without -f compares every field, and fields such as id '
                        'differ between portals; choose the fields to compare with -f', fg='yellow', err=True)
        # keep a row unless every portal has an identical one
        key = lambda row: json.dumps(row, sort_keys=True, default=str)
        portals_with = defaultdict(set)
        for name, row in table:
            portals_with[key(row)].add(name)
        table = [(name, row) for name, row in table if len(portals_with[key(row)]) < len(results)]
        if truncated:
            # rows past the size limit were never fetched, so were never compared
            click.secho(f"Warning: --diff compared only the rows fetched; more were not fetched from: "
                        f"{', '.join(truncated)} (narrow it with -F)", fg='yellow', err=True)
        if not table:
            if truncated:
                # not a clean "same": the rows not fetched may still differ
                click.secho(f'No differences in the rows fetched from {len(results)} profiles', err=True)
                sys.exit(2)
            click.secho(f'No differences between {len(results)} profiles', fg='green', err=True)
            return

    if elm.filename and elm.filename != '-':
        # one file per portal, named for it, each the same as a run with -p NAME would write
        directory, base = os.path.split(elm.filename)
        for name, *_ in results:
            mine = [row for portal, row in table if portal == name]
            if mine:
                output(mine, elm.command, os.path.join(directory, f'{name}-{base}'),
                       elm.format, elm.noheader, elm.index, elm.head, elm.foot)
    elif table:
        # profile is unique; account_name is not (two tokens on one portal) but is what others know it by
        account = {name: account_name for name, _, _, account_name in elm.portals}
        output([{'profile': name, 'account_name': account[name], **row} for name, row in table],
               elm.command, elm.filename, elm.format, elm.noheader, elm.index, elm.head, elm.foot)

    if elm.diff:
        sys.exit(1)


def output(items, command, filename='-', format='json', noheader=False, index=False, head='', foot=''):
    import pandas as pd
    from tabulate import tabulate
    import htmlmin
    from pygments import highlight, lexers, formatters

    df = pd.DataFrame(items)
    logging.debug('df: %s', df)

    if not df.empty:
        pd.set_option('display.max_columns', 0)
        pd.set_option('display.max_colwidth', 0)

        #todo: convert any columns with an subdict

        #number index from 1 instead of 0
        df.index = df.index + 1

        logging.debug('format: %s', format)
        logging.debug('noheader: %s', noheader)
        logging.debug('index: %s', index)
        logging.debug('dtypes:\n%s', df.dtypes)

        if format == 'sqlite':
            import sqlite3
            import datetime
            if filename == '-':
                click.secho('Error: sqlite format requires -o/--filename (cannot write to stdout)', fg='red', err=True)
                raise click.Abort()
            # CamelCase command name to snake_case table name
            table = re.sub(r'(?<!^)(?=[A-Z])', '_', command).lower()
            # serialize any nested dict/list values to JSON strings for SQLite storage
            df = df.map(lambda v: json.dumps(v) if isinstance(v, (dict, list)) else v)
            df.insert(0, 'fetched_at', datetime.datetime.utcnow().isoformat(timespec='seconds') + 'Z')
            conn = sqlite3.connect(filename)
            df.to_sql(table, conn, if_exists='append', index=False)
            conn.close()
            click.secho(f"Appended {len(df)} rows to table '{table}' in {filename}", fg='green', err=True)
            return

        #set headers to an empty array, this is for passing
        #to tabulate as it doesn't understand header=False
        if noheader:
            colheads=[]
        else:
            colheads=df.columns

        logging.debug('colheads: %s', colheads)

        if format == 'csv':
            output = df.to_csv(header=not noheader, index=index)
            #to_csv adds a blank line to the end, this is to remove it
            output = output[:-1]
        elif format == 'tsv':
            output = df.to_csv(sep='\t', header=not noheader, index=index)
            output = output[:-1]
        elif format == 'html':
            output = htmlmin.minify(df.to_html(header=not noheader, index=index, render_links=True, escape=False), remove_empty_space=True)
        elif format == 'prettyhtml':
            output = highlight(df.to_html(header=not noheader, index=index, render_links=True, escape=False), lexers.HtmlLexer(), formatters.TerminalFormatter())
        elif format == 'jira':
            #next line is a workaround for unescaped pipes bug: https://github.com/astanin/python-tabulate/issues/241
            df = df.map(lambda s: s.replace('|','\\|') if isinstance(s, str) else s)
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="jira", floatfmt='.0f')
        elif format == 'json':
            output = json.dumps({command: items})
        elif format == 'jsonl':
            #to_json(lines=True) terminates the last record too, and click.echo
            #adds its own newline - strip it so the stream has no blank last line
            output = df.to_json(orient='records', lines=True)[:-1]
        elif format == 'prettyjson':
            formatted_json=json.dumps({command: items}, sort_keys=True, indent=2)
            colorful_json = highlight(formatted_json, lexers.JsonLexer(), formatters.TerminalFormatter())
            output = colorful_json.rstrip("\n")
        elif format == 'xml':
            output = df.to_xml(pretty_print=False)
        elif format == 'prettyxml':
            output = df.to_xml(pretty_print=True)
        elif format in ('gfm', 'md'):
            # md is an alias for gfm: it used to be tabulate's "simple" style,
            # which is not a Markdown table at all (and was byte-identical to
            # -f tab). See issue #55. They share a branch so they cannot drift
            # apart again -- note "simple" needed no pipe escaping, a real pipe
            # table does.
            #next line is a workaround for unescaped pipes bug: https://github.com/astanin/python-tabulate/issues/241
            df = df.map(lambda s: s.replace('|','\\|') if isinstance(s, str) else s)
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="github", floatfmt='.0f')
        elif format == 'latex':
            #to_latex also ends with a newline; same trailing blank line as jsonl
            output = df.to_latex(header=not noheader, index=index)[:-1]
        elif format == 'pipe':
            #next line is a workaround for unescaped pipes bug: https://github.com/astanin/python-tabulate/issues/241
            df = df.map(lambda s: s.replace('|','\\|') if isinstance(s, str) else s)
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="pipe", floatfmt='.0f')
        elif format == 'rst':
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="rst", floatfmt='.0f')
        elif format == 'tab':
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="simple", floatfmt='.0f')
        elif format == 'values':
            # single field: one bare value per line; multiple fields: TSV, no headers
            if len(df.columns) == 1:
                output = '\n'.join(df.iloc[:, 0].astype(str))
            else:
                output = df.to_csv(sep='\t', header=False, index=False)[:-1]
        elif format == 'raw':
            output = items
        else:
            # fail to plain txt
            output = tabulate(df, headers=colheads, showindex=index, tablefmt="plain", floatfmt='.0f')

        try:
            output_file = click.open_file(filename, mode='w')
        except Exception as e:
            # Handle any unexpected exceptions in file handling
            click.secho(f"Error: Could not open the file '{filename}'", fg='red', err=True)
            click.secho(f"Exception: {str(e)}", fg='red', err=True)
            raise click.Abort()

        if head:
            output = head + '\n\n' + output

        if foot:
            output = output + '\n\n' + foot

        click.echo(output, file=output_file)
    elif len(df.columns) == 0 and len(df.index) > 0:
        click.secho('Error: no valid fields selected', fg='red', err=True)
    else:
        click.secho('Warning: no data found', fg='yellow', err=True)

def validate_filter(ctx, param, filters):
    if filters:
        # multiple=True means Click passes a tuple; flatten to a single comma-joined string
        if isinstance(filters, tuple):
            filters = ','.join(f for f in filters if f)
        filters_fmtchkd=[]
        logging.debug('filters: %s', filters)
        logging.debug('filters_fmtchkd: %s', filters_fmtchkd)
        #split filters by commas except if they're proceeded by a backslash
        for filter in re.split(r"(?<!\\),", filters):
            #now remove the backslash we used to protect the comma from split above
            logging.debug(r'filter (inc \,): %s', filter)
            filter = filter.replace(r'\,',',')
            logging.debug(r'filter (rem \,): %s', filter)
            try:
                field, operator, value = re.split(r'(>\:|<\:|>|<|\:|\!~|\!\:|~)', filter, 1)

                logging.debug('field: %s', field)
                logging.debug('operator: %s', operator)
                logging.debug('value: %s', value)
                #filter needs quotes around the value to work for strings
                #this saves the user from having to escape quotes on the cli
                #ints are not unaffected, so do it for everything
                #escape any backslash or double-quote already in the value first,
                #otherwise a trailing backslash escapes our closing quote (or an
                #embedded quote ends the value early) and LM rejects it with a 400.
                #backslash must be escaped before the quote so we don't double our own.
                value = value.replace('\\', '\\\\').replace('"', '\\"')
                value = '"' + value + '"'
                logging.debug('value: %s', value)
                filters_fmtchkd.append(field + operator + value)
                logging.debug('filters_fmtchkd: %s', filters_fmtchkd)
            except ValueError:
                #re.split with maxsplit=1 returns a single element (failing the
                #3-way unpack) only when the clause contains no operator. The most
                #common cause is an unescaped comma in a value: commas separate
                #clauses, so 'name~Smith, Inc' splits into 'name~Smith' and ' Inc',
                #and ' Inc' has no operator. Point the user at the \, escape.
                raise click.BadParameter(
                    "filter clause %r has no operator "
                    "(expected FIELD[>:,<:,>,<,!:,:,~,!~]VALUE); "
                    "to include a literal comma in a value, escape it as '\\,'" % filter)

        return ",".join(filters_fmtchkd)
