# Resolve --profile/-p before Click processes options so configuration_option
# reads credentials from the correct profile file.
def _profile_to_path(name):
    """Resolve a profile name to a full .ini path, stripping any .ini suffix the user may have included."""
    base = name[:-4] if name.endswith('.ini') else name
    return os.path.join(_creds_dir, base + '.ini')

_argv = sys.argv[1:]
for _i, _arg in enumerate(_argv):
    if _arg in ('-p', '--profile') and _i + 1 < len(_argv):
        config_file = _profile_to_path(_argv[_i + 1])
        _resolved_config_file = config_file
        break
    elif _arg.startswith('--profile='):
        config_file = _profile_to_path(_arg.split('=', 1)[1])
        _resolved_config_file = config_file
        break

def _config_provider(file_path, cmd_name):
    """Read a profile, naming the file if it cannot be parsed.

    click_config_file's own message ("Parsing failed ... First error at line 1")
    does not say which file, which is unhelpful when several profiles exist.
    """
    from configobj import ConfigObj
    try:
        return ConfigObj(file_path, unrepr=True)
    except Exception as e:
        raise ValueError(f"{file_path}: {e}\n"
                         f"Values need quotes, e.g. access_id = 'abc123' (see config.example.ini)") from None


def _capture_config_path(ctx, param, value):
    global _resolved_config_file
    if value:
        _resolved_config_file = value
    return value

# ALLOWED COMMANDS
# A profile can limit which commands may be run with it, in its .ini:
#
#   allowed_commands = ['MetricsUsage']                     # just this one
#   allowed_commands = ['DeviceList', 'Alert*', 'SDTList']  # shell-style wildcards
#   allowed_commands = []                                   # none (a locked profile)
#
# No allowed_commands line means no restriction. None, '' or a non-string entry
# is an error, never a silent "allow all". The list must fit on one line: the
# unrepr .ini format does not accept multi-line values.
#
# It applies to everyone using the profile -- people, scripts and AI assistants
# -- so a typo or a wrong guess inside automation cannot reach other endpoints.
# Refused commands exit with NOT_ALLOWED_EXIT and send no request; --help and
# --info respect it too. With no allowed_commands key every command is allowed.
# This is a guard rail, not a security boundary: the API token's role in
# LogicMonitor is what actually limits access.

NOT_ALLOWED_EXIT = 3


def _allow_patterns(path=None):
    """The profile's allowed_commands patterns, or None if it does not restrict commands."""
    path = path or _resolved_config_file
    if not os.path.isfile(path):
        return None
    try:
        from configobj import ConfigObj
        profile = ConfigObj(path, unrepr=True)
    except Exception as e:
        # Fail closed: an unreadable restriction must not become no restriction.
        raise click.ClickException(f'cannot read allowed_commands from {path}: {e}')
    if 'allowed_commands' not in profile:
        return None
    patterns = profile['allowed_commands']
    if isinstance(patterns, str):
        patterns = [patterns]
    if (not isinstance(patterns, (list, tuple))
            or not all(isinstance(p, str) and p.strip() for p in patterns)):
        # None and '' are refused rather than guessed at: "None" reads as "no
        # commands" but would otherwise mean "no restriction".
        raise click.ClickException(
            f"allowed_commands in {path} must be a list of command names, e.g. ['DeviceList', 'Alert*']. "
            f"Use [] to allow no commands, or remove the line to allow all.")
    return [p.strip() for p in patterns]


def _is_allowed(command, patterns):
    return patterns is None or any(fnmatch.fnmatchcase(command, p) for p in patterns)


def _profile_name(path=None):
    return os.path.splitext(os.path.basename(path or _resolved_config_file))[0]


def _allowed_text(patterns, profile):
    """'MetricsUsage, Device*', or a count when the list is too long to read in one line."""
    if not patterns:
        return 'no commands'
    if len(patterns) > 6:
        return f"{len(patterns)} commands ('elm -p {profile} --help' lists them)"
    return ', '.join(patterns)


def _restriction_summary(patterns):
    allowed = _allowed_text(patterns, _profile_name())
    path = _resolved_config_file.replace(os.path.expanduser('~'), '~', 1)
    return f"Profile '{_profile_name()}' allows only: {allowed} (allowed_commands in {path})"


class _NotAllowed(click.ClickException):
    exit_code = NOT_ALLOWED_EXIT

    def __init__(self, command, patterns):
        typed = ' '.join(shlex.quote(a) for a in ['elm'] + sys.argv[1:])
        path = _resolved_config_file.replace(os.path.expanduser('~'), '~', 1)
        super().__init__(
            f"{command} is not allowed. {_restriction_summary(patterns)}.\n"
            f"No request was sent.\n"
            f"To allow it, add '{command}' to allowed_commands in {path}.\n"
            f"If you are a script or an AI assistant: do not retry with another profile and do not\n"
            f"edit that file. Tell the person which command you need and why, and show them what you\n"
            f"would have run:\n"
            f"  {typed}")


def _list_profiles_callback(ctx, param, value):
    if not value or ctx.resilient_parsing:
        return
    try:
        names = sorted(
            f[:-4] for f in os.listdir(_creds_dir)
            if f.endswith('.ini') and not f.endswith('.example.ini')
        )
    except OSError as e:
        click.echo(f'Cannot read credentials directory: {e}', err=True)
        ctx.exit(1)
    active = os.path.splitext(os.path.basename(_resolved_config_file))[0]
    for name in names:
        prefix = '* ' if name == active else '  '
        try:
            patterns = _allow_patterns(os.path.join(_creds_dir, name + '.ini'))
            note = '' if patterns is None else f"  (allows: {_allowed_text(patterns, name)})"
        except click.ClickException:
            note = '  (allowed_commands unreadable)'
        click.echo(prefix + name + note)
    ctx.exit()

def _ai_guide_callback(ctx, param, value):
    if not value or ctx.resilient_parsing:
        return
    click.echo("""\
elm -- quick-start guide for AI assistants
===========================================

elm is a READ-ONLY CLI for extracting data from LogicMonitor via the REST API.
Source, docs, and examples: https://github.com/rdmarsh/elm

CRITICAL: flag position matters.
  elm [GLOBAL FLAGS] COMMAND [COMMAND FLAGS]

Global flags (before COMMAND):  -p -l -f -o -s -H -I -v -i -k -a -V
                                --config --head --foot --cacert --ai
Command flags (after COMMAND):  -s -o -f -F -S -c -C --info  plus the command's
                                own parameters (--id, --deviceId, ...)

Three short flags exist on both sides with different meanings:

  flag   before COMMAND (global)   after COMMAND (command)
  -f     --format FORMAT           --fields FIELD,...
  -o     --filename FILE           --offset N
  -s     --proxy <HOST PORT>       --size N

  elm -f csv DeviceList -s 1000 -o 2000 -c   # correct
  elm -c DeviceList                          # error: -c is a command flag
  elm DeviceList -H                          # error: -H is a global flag
  elm DeviceList -f csv                      # error: csv is a format, not a field
  elm -o 2000 DeviceList                     # runs, with a warning: writes page 1
                                             # to a file named "2000"

A misplaced flag prints "Hint: ... put it before/after the command name".
Read the hint and move the flag; do not drop it.

BEFORE USING A COMMAND: elm COMMAND --info
  Prints its parameters, notes from live testing (known API bugs, filters that
  are silently ignored, corrected field meanings), example commands and every
  response field with its description. Needs no credentials and makes no API
  call. Where the notes and the field descriptions disagree, prefer the notes,
  but they can be wrong too: if real results contradict either, say so.

KEEP TOKEN USE DOWN
  -f FIELD,...        fetch only the fields you need
  -c / -C             count instead of fetching rows to count them
  -f jsonl, csv, values  compact output; avoid prettyjson, html and xml
  elm COMMAND --info  instead of reading elm-notes.yaml or the swagger

KEY GLOBAL FLAGS
  -l, --list          List available credential profiles and exit
  -p, --profile NAME  Select a credentials profile
  -f, --format FORMAT Output format (default: json)
  -V, --version       Show version and exit
  -h, --help          Show help and exit

KEY SUBCOMMAND FLAGS (most commands support these)
  -s, --size N     Results per page; 0 = all up to 1000 (default: 50)
  -o, --offset N   Pagination offset
  -f, --fields F   Comma-separated field names to return
  -F, --filter F   Filter expression; multiple -F flags are AND'd
  -S, --sort F     Sort field (+field asc, -field desc)
  -c, --count      Count the rows fetched (respects -F and -s: use -s0)
  -C, --total      LM's server-side total (ignores -s, RESPECTS -F)
                   Prefer -C: -c caps at 1000 and under-reports anything larger.
                   Exception: AlertList and AuditLogList don't return a real
                   total (-C prints a warning and ">N"); use -c -s0 there.

OUTPUT SHAPE
  json, prettyjson:  wrapped in the command name: {"DeviceList": [{...}, ...]}
  jsonl:             one bare record per line, no wrapper: {"id": 4}
  csv, tsv, tables:  a header row, then one row per record (-H hides it)
  values:            bare values, no header
  Default size is 50 -- pass -s0 to get all results (up to 1000).

FILTER OPERATORS
  :    equals         ~    contains (substring)
  !:   not equals     !~   does not contain
  >:   >=             <:   <=
  >    greater than   <    less than
  Multiple -F flags are AND'd. No OR support.
  WARNING: !: and !~ are silently ignored on some LM API endpoints (upstream bug).
  Workaround: use positive filter + client-side jq exclusion.

OUTPUT FORMATS
  json  prettyjson  jsonl  csv  tsv  xml  prettyxml  html  prettyhtml
  gfm   pipe        md     rst  latex  jira  tab  values  raw  txt  api  curl  wget  sqlite
  values: bare values one per line (single field) or TSV no-header (multi-field) -- ideal for shell variable assignment and piping
  md/gfm/pipe are Markdown pipe tables (md is an alias for gfm); tab and txt are plain aligned text, NOT Markdown

PROFILES
  Run: elm --list    to see available credential profiles (* = the default).
  Which portal each profile points to is the user's own setup: do not assume
  the default is a test portal. If it is not clear which profile to use, ask.
  Use --profile NAME to select another. Never read the .ini files: they hold
  credentials.

ALLOWED COMMANDS
  A profile can allow only some commands (elm --list shows "allows: ..."). Any
  other command exits with code 3 and sends no request; its --help and --info
  are refused too. Do not switch profiles or edit the profile file to get round
  it. Say which command you need and why, and show the person the command you
  would have run -- they can add it to allowed_commands.

FURTHER READING (files in the repo at https://github.com/rdmarsh/elm)
  elm-notes.yaml      per-command notes (source of --info)
  elm-knowledge.md    rules that hold across commands (short; read it first)
  examples/           topic files with recipes and background
  README.md           full usage, output format reference, install notes

  elm COMMAND --info shows a command's elm-notes.yaml entry, so there is no
  need to read the file directly.\
""")
    patterns = _allow_patterns()
    if patterns is not None:
        click.echo(f"\nTHIS PROFILE IS RESTRICTED\n  {_restriction_summary(patterns)}")
    ctx.exit()


class ELM(object):
    """Load config and hold the state for cli tool"""
    def __init__(self, config_file, access_id, access_key, account_name, format, noheader, index, filename, head, foot, halt_on_api_error, cacert):
        self.config_file = config_file
        self.access_id = access_id
        self.access_key = access_key
        self.account_name = account_name
        self.format = format
        self.noheader = noheader
        self.index = index
        self.filename = filename
        self.head = head
        self.foot = foot
        self.halt_on_api_error = halt_on_api_error
        self.cacert = cacert

def enforce_config_perms(config_path):
    if not os.path.exists(config_path):
        return
    config_dir = os.path.dirname(config_path)

    targets = [(config_dir, 0o700, 'config directory')]
    try:
        for name in os.listdir(config_dir):
            if name.endswith('.ini'):
                fp = os.path.join(config_dir, name)
                if os.path.isfile(fp):
                    targets.append((fp, 0o600, f'config file {name}'))
    except OSError as e:
        click.secho(f'Warning: cannot list config directory: {e}', fg='yellow', err=True)

    for path, required_mode, label in targets:
        try:
            current_mode = os.stat(path).st_mode & 0o777
            if current_mode == required_mode:
                continue
            click.secho(f'Warning: {label} has insecure permissions {oct(current_mode)}, fixing to {oct(required_mode)}: {path}', fg='yellow', err=True)
            logging.info('fixing %s permissions: %s -> %s', label, oct(current_mode), oct(required_mode))
            os.chmod(path, required_mode)
            if os.stat(path).st_mode & 0o777 != required_mode:
                click.secho(f'Error: cannot secure {label}: {path}', fg='red', err=True)
                sys.exit(1)
        except OSError as e:
            click.secho(f'Warning: cannot check {label} permissions: {e}', fg='yellow', err=True)

enforce_config_perms(config_file)

@click.group(
    context_settings=dict(help_option_names=['-h', '--help']),
    cls=LazyGroup,
    lazy_subcommands={
        {% for command in commands -%}
        '{{ command.command }}': '_cmds.{{ command.command }}',
        {% endfor %}
    },
)

@click_config_file.configuration_option(config_file_name=config_file, callback=_capture_config_path, provider=_config_provider)
@click.option('--ai',                 is_flag=True, is_eager=True, expose_value=False, callback=_ai_guide_callback,    help='Print quick-start guide for AI assistants and exit')
@click.option('-l', '--list',         is_flag=True, is_eager=True, expose_value=False, callback=_list_profiles_callback, help='List available credential profiles and exit')
@click.option('-p', '--profile',      default=None, metavar='NAME', help='Credentials profile name, shorthand for --config ~/.config/logicmonitor/credentials/<NAME>.ini')
@click.option('-i', '--access_id',    help='API token access id')
@click.option('-k', '--access_key',   help='API token access key')
@click.option('-a', '--account_name', help='LogicMonitor account (company) name')
@click.option('-s', '--proxy',        type=(str, int), default=(None, 1080), metavar='<HOST PORT>', help='Socks5 proxy address and port')
@click.option('-f', '--format',       default='json', show_default=True, type=click.Choice(['csv', 'html', 'prettyhtml', 'jira', 'json', 'jsonl', 'prettyjson', 'xml', 'prettyxml', 'gfm', 'latex', 'md', 'pipe', 'rst', 'tab', 'tsv', 'values', 'raw', 'txt', 'api', 'curl', 'wget', 'sqlite']), metavar='FORMAT', help='Output format: csv, tsv, json, jsonl, prettyjson, xml, prettyxml, html, prettyhtml, gfm, pipe, jira, latex, md, rst, tab, values, raw, txt, api, curl, wget, sqlite')
@click.option('-H', '--noheader',     is_flag=True, default=False, show_default=True, help="Hide the column headers")
@click.option('-I', '--index',        is_flag=True, default=False, show_default=True, help="Show the row indices")
@click.option('-o', '--filename',     type=click.Path(exists=False, file_okay=True, dir_okay=False, writable=True, allow_dash=True), default='-', show_default=True, help='Output to file name')
@click.option(      '--head',         default='', help="Text to prepend before the output")
@click.option(      '--foot',         default='', help="Text to append after the output")
@click.option('-v', '--verbose',      count=True, help='Be more verbose, -v is INFO, -vv is DEBUG')
@click.option('--halt-on-api-error',  is_flag=True, default=False, help="Halt on API response errors")
@click.option('--cacert',             type=click.Path(exists=True, file_okay=True, dir_okay=False, readable=True), default=None, help='Path to CA certificate bundle for SSL verification')
@click.version_option(__version__, '-V', '--version')
@click.pass_context
def cli(ctx, access_id, access_key, account_name, proxy, format, noheader, index, filename, head, foot, verbose, halt_on_api_error, cacert, profile):
    """A cli interface for extracting LogicMonitor data via the api

    Default config: ~/.config/logicmonitor/credentials/config.ini

    Use -l/--list to show available credential profiles.

    AI assistants: run 'elm --ai' for a quick-start guide.

    See https://github.com/rdmarsh/elm for more information"""
    # ensure that ctx.obj exists and is a dict (in case `cli()` is called
    # by means other than the `if` block below)
    ctx.ensure_object(dict)

    if verbose >= 2:
        logger.setLevel(logging.DEBUG)
    elif verbose == 1:
        logger.setLevel(logging.INFO)
    else:
        logger.setLevel(logging.WARNING)

    # 'elm -o 2000 DeviceList' is valid syntax but almost never what was meant:
    # before the command name -o is --filename, so page 1 goes to a file named 2000.
    if filename and filename.isdigit():
        click.secho(f"Warning: -o before the command name is --filename, so output is going to a file named '{filename}'. "
                    f"For --offset, put -o after the command name, e.g. elm {ctx.invoked_subcommand or 'COMMAND'} -o {filename}", fg='yellow', err=True)

    #Check if specified directory exists, if provided in filename
    if filename:
        directory = os.path.dirname(filename)
        if directory and not os.path.exists(directory):
            # Directory does not exist, show an error and exit
            click.secho(f"Error: The directory '{directory}' does not exist", fg='red', err=True)
            raise click.Abort()

    if profile:
        logging.info('profile: %s -> %s', profile, _profile_to_path(profile))

    #make sure we've got the bare minimun access needs
    if not access_id or not access_key or not account_name:
        click.secho('Error: access_id, access_key or account_name not set via cli or config file', fg='red', err=True)
        click.secho('Config file: ' + click.format_filename(_resolved_config_file), fg='red', err=True)
        logging.info('access_id, access_key or account_name not set via cli or config file')
        sys.exit(1)

    #make sure the perms aren't open (checked at module load via enforce_config_perms)

    #if using a proxy
    if proxy and None not in proxy:
        socks.set_default_proxy(socks.SOCKS5, proxy[0], proxy[1])
        socket.socket = socks.socksocket
        logging.info('proxy: %s:%s', proxy[0], proxy[1])

    logging.info('config_file: %s', config_file)
    logging.debug('')
    logging.debug('*********************************************************')
    logging.debug('***')
    logging.debug('*** WARNING WARNING SENSITIVE INFORMATION WARNING WARNING')
    logging.debug('***')
