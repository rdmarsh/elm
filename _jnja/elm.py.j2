class LazyGroup(click.Group):
    """Click Group that defers command module imports until the command is invoked."""
    def __init__(self, *args, lazy_subcommands=None, **kwargs):
        super().__init__(*args, **kwargs)
        self.lazy_subcommands = lazy_subcommands or {}

    def list_commands(self, ctx):
        # A restricted profile only lists the commands it allows (see allowed_commands).
        patterns = _allow_patterns()
        return sorted(c for c in self.lazy_subcommands if _is_allowed(c, patterns))

    def format_commands(self, ctx, formatter):
        super().format_commands(ctx, formatter)
        patterns = _allow_patterns()
        if patterns is not None:
            if not self.list_commands(ctx):
                # Without this the help has no Commands section at all, which reads as a fault.
                with formatter.section('Commands'):
                    formatter.write_text('(none allowed by this profile)')
            with formatter.section('Restricted profile'):
                formatter.write_text(_restriction_summary(patterns))

    def get_command(self, ctx, cmd_name):
        if cmd_name in self.lazy_subcommands:
            module = importlib.import_module(self.lazy_subcommands[cmd_name])
            return getattr(module, cmd_name)
        return super().get_command(ctx, cmd_name)

    # Global options go before the command name, command options after it, and
    # -f/-o/-s mean different things on each side. Click's own errors ("no such
    # option: -c") don't say that, so add the fix to the message.

    def parse_args(self, ctx, args):
        original = list(args)  # the parser consumes args in place
        try:
            return super().parse_args(ctx, args)
        except click.UsageError as e:
            command_name = next((a for a in original if a in self.lazy_subcommands), None)
            _add_position_hint(e, self, ctx, command_name, before_command=True)
            raise

    def invoke(self, ctx):
        args = ctx.protected_args + ctx.args
        # Checked before anything else, including --help, --info and the
        # credentials check, so a refused command sends no request and a
        # restricted profile does not describe commands it cannot run.
        if args and args[0] in self.lazy_subcommands:
            patterns = _allow_patterns()
            if not _is_allowed(args[0], patterns):
                raise _NotAllowed(args[0], patterns)
        try:
            # 'elm COMMAND --info' and 'elm COMMAND --help' describe the command
            # and exit. Parse the command's own options first so they work
            # before cli() insists on credentials.
            if args and args[0] in self.lazy_subcommands and {'--info', '--help', '-h'} & set(args[1:]):
                self.get_command(ctx, args[0]).make_context(args[0], list(args[1:]), parent=ctx)
            return super().invoke(ctx)
        except click.UsageError as e:
            if e.ctx is not None and e.ctx.command is not self:
                _add_position_hint(e, self, ctx, e.ctx.info_name, before_command=False)
            raise


def _options_by_flag(command):
    """Map every flag spelling (-c, --count) of a command to its parameter."""
    return {flag: p for p in command.params for flag in p.opts + p.secondary_opts}


def _long_flag(param):
    return max(param.opts, key=len)


def _flag_usage(flag, param):
    """'-p NAME', '-c': the flag plus a short placeholder for its value, if it takes one."""
    if getattr(param, 'is_flag', False) or getattr(param, 'count', False):
        return flag
    metavar = param.metavar
    if not metavar or len(metavar) > 12 or metavar in ('INTEGER', 'TEXT'):
        metavar = param.name.upper()
    return f'{flag} {metavar}'


def _add_position_hint(error, group, ctx, command_name, before_command):
    """Append 'put it before/after the command name' to a misplaced-flag error."""
    try:
        command = group.get_command(ctx, command_name) if command_name else None
    except Exception:
        command = None
    if command is None:
        return
    there = _options_by_flag(command) if before_command else _options_by_flag(group)
    side = 'after' if before_command else 'before'

    def placed(flag):
        usage = _flag_usage(flag, there[flag])
        return f'elm {command_name} {usage}' if before_command else f'elm {usage} {command_name}'

    hint = None
    if isinstance(error, click.NoSuchOption) and error.option_name in there:
        flag = error.option_name
        kind = 'a command' if before_command else 'a global'
        hint = f'{flag} is {kind} option: put it {side} the command name, e.g. {placed(flag)}'
    elif isinstance(error, click.BadParameter) and error.param is not None:
        shared = [flag for flag in error.param.opts if flag in there]
        if shared:
            flag = shared[0]
            position = 'before' if before_command else 'after'
            hint = (f'{flag} {position} the command name is {_long_flag(error.param)}; '
                    f'for {_long_flag(there[flag])} put it {side} the command name, '
                    f'e.g. {placed(flag)}')
    if hint:
        error.message = f'{error.message}\nHint: {hint}'

