#!/bin/sh
# qlm: query LogicMonitor in plain English; the answer comes back as Markdown.
#
#   qlm how many devices are in SDT right now
#   qlm "which collectors are down?" | glow
#   QLM_PROFILE="ai-prod ai-preprod" qlm which collectors are missing in preprod
#
# Claude Code answers (on your Claude login, not API credits) with elm-ask's
# read-only tools and nothing else: no shell, no files. The tools run in the
# elm-ask Docker image with your credentials mounted read-only; build it first
# (tools/elm-ask/README.md).
#
#   QLM_PROFILE  credential profile(s), one per portal to ask
#                (default ai; each must set allowed_commands)
#   QLM_MODEL    Claude model (default sonnet)
#   ELM_CACERT   CA bundle inside the container, as elm --cacert
#   QLM_LOG      1 to log questions to $XDG_STATE_HOME/qlm/qlm.log
#                (~/.local/state/qlm/qlm.log), or a path to log to
set -eu

usage() {
    cat <<'END'
usage: qlm QUESTION            ask a LogicMonitor portal, in plain English
       qlm --info              what it would use: portal, profile, versions
       qlm --help

Claude Code answers on your Claude login, using elm-ask's read-only tools
in the elm-ask Docker image. The answer is Markdown on stdout.

  QLM_PROFILE  credential profile(s), one per portal to ask (default ai)
  QLM_MODEL    Claude model (default sonnet)
  QLM_LOG      1 to log questions to $XDG_STATE_HOME/qlm/qlm.log, or a path
END
}

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    --info) info=yes; shift ;;
esac
[ $# -gt 0 ] || [ "${info:-}" = yes ] || { usage >&2; exit 2; }

# --restricted is the check that also tells old versions apart: the ones without
# it answer before the MCP server has connected, which looks like a broken qlm.
claude --help 2>/dev/null | grep -q -- --restricted || {
    echo "qlm: this Claude Code is too old ($(claude --version 2>&1 | head -1)): it has no" >&2
    echo "     --restricted, and versions that old answer before the elm tools load." >&2
    echo "     Run: claude update" >&2
    exit 2
}

creds=$HOME/.config/logicmonitor/credentials

# ELM_CACERT, when set, is passed on as elm --cacert inside the container: the
# last word on TLS for networks that inspect it. The path is the container's --
# a CA built into the image (tools/elm-ask/certs/) is at the bundle below.
cacert=
[ -n "${ELM_CACERT:-}" ] && cacert="\"-e\",\"ELM_CACERT=$ELM_CACERT\","

# One container per profile, so a question can compare two portals, and so each
# container holds only the one profile it uses -- not every credential you own.
servers=
allow=
for profile in ${QLM_PROFILE:-ai}; do
    # Only the ai profiles, so a tired QLM_PROFILE cannot reach an everyday
    # token. A guard against your own mistake, not a boundary: what a profile
    # may do is decided by its allowed_commands and its LM role, not its name.
    case $profile in
        ai|ai-*) ;;
        *) echo "qlm: only 'ai' profiles can be used, not '$profile' (see tools/elm-ask/README.md)" >&2; exit 2 ;;
    esac
    [ -f "$creds/$profile.ini" ] || { echo "qlm: no such profile: $creds/$profile.ini" >&2; exit 2; }
    name=elm_$(printf %s "$profile" | tr -c 'A-Za-z0-9' _)
    servers="$servers${servers:+,}\"$name\":{\"command\":\"docker\",\"args\":[\
\"run\",\"-i\",\"--rm\",\"--user\",\"$(id -u)\",\
\"--cap-drop\",\"ALL\",\"--security-opt\",\"no-new-privileges\",\
\"-e\",\"ELM_CONFIG=/creds/$profile.ini\",$cacert\
\"-v\",\"$creds/$profile.ini:/creds/$profile.ini:ro\",\
\"elm-ask\",\"python\",\"/opt/elm/tools/elm-ask/mcp_server.py\"]}"
    allow="$allow mcp__$name"
done

if [ "${info:-}" = yes ]; then
    echo "qlm:      $0"
    echo "model:    ${QLM_MODEL:-sonnet}"
    echo "log:      ${QLM_LOG:-off}"
    echo "claude:   $(claude --version 2>&1 || echo 'not found')"
    echo "image:    elm-ask, built $(docker image inspect -f '{{.Created}}' elm-ask 2>/dev/null || echo 'not built')"
    for profile in ${QLM_PROFILE:-ai}; do
        echo
        echo "config:   $creds/$profile.ini"
        docker run -i --rm --user "$(id -u)" --cap-drop ALL --security-opt no-new-privileges \
            -e "ELM_CONFIG=/creds/$profile.ini" -v "$creds/$profile.ini:/creds/$profile.ini:ro" \
            elm-ask python /opt/elm/tools/elm-ask/mcp_server.py --info
    done
    exit 0
fi

# Opt-in record of what was asked, and of which portal. Questions can name a
# device or a site, so the file is kept private (0600 in a 0700 directory).
# Answers are never logged: they carry portal data, and LM's own audit log
# already records every request the profile's token made.
if [ -n "${QLM_LOG:-}" ]; then
    case $QLM_LOG in
        1) log=${XDG_STATE_HOME:-$HOME/.local/state}/qlm/qlm.log ;;
        *) log=$QLM_LOG ;;
    esac
    ( umask 077
      mkdir -p "$(dirname "$log")"
      printf '%s\t%s\t%s\n' "$(date +%FT%T%z)" "${QLM_PROFILE:-ai}" "$*" >> "$log" )
fi

# claude -p skips the trust dialog and loads settings files silently, so keep
# both out of it: an empty directory (no CLAUDE.md, no project settings) and
# --restricted (ignores user settings, refuses bypassPermissions).
cd "${TMPDIR:-/tmp}"
# Your local time, so the answer gives times in it rather than in UTC; a plain
# error, not a guess, when the MCP server did not connect in time; and an
# off-topic question answered, but marked as not coming from the portal. The
# two used to share one line, and "no elm tools" was read as "no elm tools
# that fit", so an off-topic question got the load error.
question="$*

(Now: $(date '+%Y-%m-%d %H:%M %Z, UTC%z') for the reader. Give times in it.
The elm tools are the ones named mcp__elm_*. Only if none are available to
you, reply only: qlm: the elm tools did not load.
If they are available but the question is not about LogicMonitor, answer it
briefly from what you know, then end with this line: _Not from LogicMonitor:
general knowledge, worth checking._ If you cannot answer it, say so in one line.)"

# $allow is a list of server names (letters, digits and _), so it is deliberately unquoted.
exec claude -p "$question" \
    --mcp-config "{\"mcpServers\":{$servers}}" --strict-mcp-config \
    --tools "" --allowedTools $allow --permission-mode dontAsk --restricted \
    --no-session-persistence \
    --model "${QLM_MODEL:-sonnet}" </dev/null
